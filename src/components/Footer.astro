---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/logo/full-logo-black.svg" alt="Bördie" height="30" width="65" />
      <p class="tagline">Der intelligente Golf-Caddie fürs Smartphone.</p>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/e-learning">E-Learning</a>
      <a href="/demo">Demo</a>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>©{year} Bördie · Major Project</p>
    <p class="muted">Ein Bachelor of Science Projekt, noch nicht im App Store veröffentlicht.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 2px solid var(--ink);
    background: var(--bg);
    padding-block: 56px 32px;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-brand img {
    height: 30px;
    width: auto;
    margin-bottom: 12px;
  }

  .tagline {
    color: var(--ink-muted);
    font-size: 0.95rem;
    max-width: 32ch;
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: line-through;
    text-decoration-color: transparent;
    text-decoration-thickness: 3px;
    transition: text-decoration-color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--ink);
    text-decoration-color: var(--green);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    justify-content: space-between;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom .muted {
    color: var(--ink-muted);
  }
</style>
