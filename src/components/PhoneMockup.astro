---
// Modernes iPhone-Mockup (reines CSS) mit einem angedeuteten bördie-App-Screen
// im dunklen App-Look. Die echte App existiert noch nicht – das ist ein
// Konzept-Screen (Schläger-Empfehlung pro Loch + Caddie).
---

<div class="phone" role="img" aria-label="bördie App: Schläger-Empfehlung für Loch 1 – Eisen 7">
  <div class="island" aria-hidden="true"></div>
  <div class="screen">
    <!-- Statusleiste -->
    <div class="status">
      <span class="time">9:41</span>
      <span class="status-icons" aria-hidden="true">
        <svg viewBox="0 0 20 12" width="18" height="11"><rect x="0" y="7" width="3" height="5" rx="1"/><rect x="5" y="4" width="3" height="8" rx="1"/><rect x="10" y="2" width="3" height="10" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
        <svg viewBox="0 0 24 12" width="20" height="10"><rect x="1" y="1" width="19" height="10" rx="3" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="21" y="4" width="2" height="4" rx="1"/><rect x="3" y="3" width="14" height="6" rx="1.5"/></svg>
      </span>
    </div>

    <!-- App-Header -->
    <div class="scr-header">
      <img src="/logo/logo-white.svg" alt="" class="scr-mark" width="16" height="30" />
      <div class="scr-head-text">
        <div class="scr-course">Otelfingen</div>
        <div class="scr-sub">18 Löcher · Tee Gelb</div>
      </div>
      <span class="scr-hole">Loch 1</span>
    </div>

    <!-- Empfehlungs-Karte -->
    <div class="scr-rec">
      <div class="scr-rec-top">
        <span class="scr-tag">Empfohlen</span>
        <span class="scr-dist">148 m zur Fahne</span>
      </div>
      <div class="scr-club">Eisen 7</div>
      <p class="scr-reason">Sicher aufs Grün – dein Carry passt, den Bunker links vermeidest du.</p>
    </div>

    <!-- Caddie -->
    <div class="scr-caddie">
      <div class="scr-bubble scr-user">Warum nicht Eisen 6?</div>
      <div class="scr-bubble scr-ai">Eisen 6 wäre ca. 12 m zu lang – du würdest das Grün überspielen.</div>
    </div>
  </div>
</div>

<style>
  /* dunkle App-Palette – lokal, da die Website sonst hell ist */
  .phone {
    --d-bg: #0a0c0b;
    --d-card: #161a17;
    --d-card-2: #1c211d;
    --d-line: #2a2f2b;
    --d-green: #04782f;
    --d-green-bright: #2fae64;
    --d-text: #f4f7f5;
    --d-2: #c2c9c4;
    --d-muted: #8a938c;

    position: relative;
    width: min(300px, 78vw);
    aspect-ratio: 9 / 19.2;
    background: #050605;
    border-radius: 46px;
    padding: 11px;
    box-shadow:
      0 2px 0 2px #2b302c inset,
      0 40px 80px -30px rgba(0, 0, 0, 0.55),
      0 10px 30px -12px rgba(4, 120, 47, 0.35);
  }

  /* Seitenknöpfe */
  .phone::before,
  .phone::after {
    content: '';
    position: absolute;
    left: -3px;
    width: 3px;
    border-radius: 3px 0 0 3px;
    background: #1a1d1a;
  }
  .phone::before {
    top: 120px;
    height: 34px;
  }
  .phone::after {
    top: 170px;
    height: 56px;
  }

  .island {
    position: absolute;
    top: 22px;
    left: 50%;
    transform: translateX(-50%);
    width: 92px;
    height: 26px;
    background: #000;
    border-radius: 999px;
    z-index: 3;
  }

  .screen {
    position: relative;
    height: 100%;
    background: var(--d-bg);
    border-radius: 36px;
    overflow: hidden;
    padding: 16px 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: system-ui, -apple-system, sans-serif;
    color: var(--d-text);
  }

  .status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px 0;
    font-size: 13px;
  }
  .time {
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .status-icons {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--d-text);
    fill: currentColor;
  }

  .scr-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 4px;
  }
  .scr-mark {
    height: 30px;
    width: auto;
  }
  .scr-head-text {
    flex: 1;
    min-width: 0;
  }
  .scr-course {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .scr-sub {
    font-size: 12px;
    color: var(--d-muted);
  }
  .scr-hole {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--d-card-2);
    border: 1px solid var(--d-line);
    color: var(--d-2);
  }

  .scr-rec {
    background: linear-gradient(160deg, var(--d-card-2), var(--d-card));
    border: 1px solid var(--d-line);
    border-radius: 20px;
    padding: 16px 16px 18px;
  }
  .scr-rec-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .scr-tag {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--d-green);
    color: #fff;
  }
  .scr-dist {
    font-size: 12px;
    color: var(--d-2);
  }
  .scr-club {
    font-family: var(--font-display);
    font-weight: 900;
    font-style: italic;
    text-transform: uppercase;
    font-size: 40px;
    line-height: 1;
    color: var(--d-green-bright);
    margin: 2px 0 8px;
  }
  .scr-reason {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--d-2);
  }

  .scr-caddie {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
  }
  .scr-bubble {
    font-size: 12.5px;
    line-height: 1.4;
    padding: 10px 13px;
    border-radius: 16px;
    max-width: 82%;
  }
  .scr-user {
    align-self: flex-end;
    background: var(--d-green);
    color: #fff;
    border-bottom-right-radius: 5px;
  }
  .scr-ai {
    align-self: flex-start;
    background: var(--d-card-2);
    border: 1px solid var(--d-line);
    color: var(--d-2);
    border-bottom-left-radius: 5px;
  }
</style>
