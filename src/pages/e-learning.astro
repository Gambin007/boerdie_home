            <text x="258" y="157" text-anchor="middle" class="kolb-node-n">2</text>
            <circle cx="150" cy="258" r="21" fill="var(--green)" />
            <text x="150" y="265" text-anchor="middle" class="kolb-node-n">3</text>
            <circle cx="42" cy="150" r="21" fill="var(--green)" />
