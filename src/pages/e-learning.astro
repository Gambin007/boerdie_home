<script>
  const course = document.querySelector<HTMLElement>('[data-course]');
  if (course) {
    const steps = Array.from(course.querySelectorAll<HTMLElement>('[data-step]'));
    const dots = Array.from(course.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const fill = course.querySelector<HTMLElement>('[data-fill]');
    const counter = course.querySelector<HTMLElement>('[data-counter]');
    const prevBtn = course.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = course.querySelector<HTMLButtonElement>('[data-next]');
    let current = 0;

    function render(scroll: boolean) {
      steps.forEach((s, i) => s.classList.toggle('is-active', i === current));
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === current);
        d.classList.toggle('is-done', i < current);
      });
      if (fill) fill.style.width = ((current + 1) / steps.length) * 100 + '%';
      if (counter) counter.textContent = String(current + 1);
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn)
        nextBtn.textContent =
          current === 0 ? 'Starten' : current === steps.length - 1 ? 'Fertig' : 'Weiter';
      if (scroll) course!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function go(i: number) {
      current = Math.max(0, Math.min(steps.length - 1, i));
      render(true);
    }
    const doneEl = course.querySelector<HTMLElement>('[data-done]');
    prevBtn?.addEventListener('click', () => go(current - 1));
    nextBtn?.addEventListener('click', () => {
      if (current < steps.length - 1) {
        go(current + 1);
      } else {
        course!.classList.add('is-finished');
        if (doneEl) doneEl.hidden = false;
        course!.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    // Abschluss-Screen: „Kurs nochmal starten"
    course.querySelector<HTMLButtonElement>('[data-restart-course]')?.addEventListener('click', () => {
      course!.classList.remove('is-finished');
      if (doneEl) doneEl.hidden = true;
      go(0);
    });

    // Quiz-Übungen
    course.querySelectorAll<HTMLElement>('[data-quiz]').forEach((quiz) => {
      const opts = Array.from(quiz.querySelectorAll<HTMLButtonElement>('button[data-opt]'));
      const feedback = quiz.querySelector<HTMLElement>('[data-feedback]');
      opts.forEach((btn) => {
        btn.addEventListener('click', () => {
          // Nach der Antwort alle Optionen auflösen: richtig = grün, falsch = rot
          opts.forEach((b) => {
            b.disabled = true;
            b.classList.add(b.dataset.opt === 'correct' ? 'is-correct' : 'is-wrong');
          });
          btn.classList.add('is-chosen');

          // Rückmeldung: war die eigene Wahl richtig?
          const ok = btn.dataset.opt === 'correct';
          const verdict = quiz.querySelector<HTMLElement>('[data-verdict]');
          if (verdict) {
            // „Falsch." rot, „Lösung:" grün – der Hinweis selbst ist ja etwas Positives
            const part = (cls: string, txt: string) => {
              const s = document.createElement('span');
              s.className = cls;
              s.textContent = txt;
              return s;
            };
            verdict.textContent = '';
            if (ok) {
              verdict.append(part('v-ok', 'Richtig.'), ' ');
            } else {
              verdict.append(part('v-bad', 'Falsch.'), ' ', part('v-ok', 'Lösung:'), ' ');
            }
          }
          feedback?.classList.add('show');
        });
      });
    });

    // ---- Glossar: Golf-Fachbegriffe automatisch erklären ----
    // Die Zielgruppe (SAE-Absolvent·innen) spielt nicht zwingend Golf.
    // Erklärt wird pro Kapitel jeweils das erste Vorkommen eines Begriffs.
    const glossary: Record<string, string> = {
      Handicap:
        'Kennzahl für das Spielniveau. Je tiefer, desto besser. Handicap 18 heisst grob: rund 18 Schläge mehr als ein Profi über 18 Löcher.',
      Carry:
        'Die Strecke, die der Ball durch die Luft fliegt, bis er zum ersten Mal aufkommt. Ohne den Rollweg danach.',
      Lie: 'Wie der Ball am Boden liegt: sauber auf kurzem Gras, im hohen Gras oder im Sand. Das beeinflusst, wie weit der Schlag trägt.',
      Fairway: 'Die kurz gemähte Spielbahn zwischen Abschlag und Grün. Von dort lässt es sich am besten schlagen.',
      Grün: 'Die sehr kurz gemähte Fläche rund um das Loch. Hier wird nur noch geputtet.',
      Bunker: 'Eine mit Sand gefüllte Vertiefung als Hindernis. Aus dem Sand ist die Distanz schwer zu kontrollieren.',
      Par: 'Die Anzahl Schläge, die für ein Loch vorgesehen ist. Ein Par 3 sollte also mit drei Schlägen gespielt sein.',
      'Stroke-Index': 'Rangfolge der Schwierigkeit aller 18 Löcher eines Platzes. 1 ist das schwerste Loch, 18 das leichteste.',
      Abschlag: 'Der Startbereich eines Lochs. Verschiedene Abschlagfarben stehen für verschiedene Längen.',
      Streuung: 'Wie weit die Bälle typischerweise seitlich vom Ziel abweichen. Je grösser die Streuung, desto unsicherer der Schläger.',
      Slice: 'Ein Fehlschlag, bei dem der Ball stark zur Seite wegdreht. Bei Rechtshändern nach rechts.',
      Birdie: 'Ein Loch mit einem Schlag weniger als Par. Der Namensgeber dieses Projekts.',
      Hybrid: 'Ein Schlägertyp zwischen Eisen und Holz. Fliegt weit, ist aber leichter zu treffen als ein langes Eisen.',
      Wedge: 'Kurze Schläger mit stark geneigter Schlagfläche für Annäherungen ans Grün.',
      Landezone: 'Der Bereich, in dem der Ball nach dem Schlag idealerweise landen soll.',
      Rough: 'Das höhere, ungemähte Gras neben dem Fairway. Der Ball lässt sich dort schlechter kontrollieren.',
      Driver: 'Der längste Schläger im Bag. Maximale Weite, dafür am schwersten präzise zu treffen.',
      Bag: 'Die Zusammenstellung der Schläger, die ein Spieler dabei hat. Maximal 14 Stück.',
    };

    const terms = Object.keys(glossary).sort((a, b) => b.length - a.length);
    // Wortgrenzen + optionale deutsche Endungen (Handicaps, Bunkern …)
    const pattern = new RegExp(
      '(?<![\\wäöüÄÖÜß-])(' + terms.map((t) => t.replace('-', '\\-')).join('|') + ')(s|n|en|er|e)?(?![\\wäöüÄÖÜß-])',
    );

    function annotate(step: HTMLElement) {
      const used = new Set<string>();
      const walker = document.createTreeWalker(step, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          const p = (node as Text).parentElement;
          if (!p || !node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
          // Überschriften, Code, Labels und Buttons bleiben unangetastet
          if (p.closest('h1,h2,h3,code,pre,button,.term,.eyebrow,.chapter-num,.meta,.learn-tag,.quiz-badge,.hole-meta,.calc,.flow,.score-box,.ex-tags,.kolb-circle,.round-flow'))
            return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        },
      });
      const targets: Text[] = [];
      let n: Node | null;
      while ((n = walker.nextNode())) targets.push(n as Text);

      targets.forEach((textNode) => {
        const m = pattern.exec(textNode.nodeValue || '');
        if (!m) return;
        const term = m[1];
        if (used.has(term)) return;
        used.add(term);
        const after = textNode.splitText(m.index);
        after.nodeValue = (after.nodeValue || '').slice(m[0].length);
        const span = document.createElement('span');
        span.className = 'term';
        span.tabIndex = 0;
        span.textContent = m[0];
        const tip = document.createElement('span');
        tip.className = 'term-tip';
        tip.setAttribute('role', 'tooltip');
        tip.textContent = glossary[term];
        span.appendChild(tip);
        after.parentNode?.insertBefore(span, after);
      });
    }
    steps.forEach((s) => annotate(s));

    render(false);
  }
</script>

