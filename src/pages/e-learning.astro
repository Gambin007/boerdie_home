                <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--green)" />
              </marker>
            </defs>
            <!-- vier Viertelbögen mit Pfeil, im Uhrzeigersinn -->
            <path d="M 168 42 A 108 108 0 0 1 258 132" fill="none" stroke="var(--green)" stroke-width="3" marker-end="url(#kolbArrow)" />
            <path d="M 258 168 A 108 108 0 0 1 168 258" fill="none" stroke="var(--green)" stroke-width="3" marker-end="url(#kolbArrow)" />
